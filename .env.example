# ============================================
# Agentic WarRoom — Environment Variables
# ============================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# NEVER commit .env to git.

# ------------------------------------------
# Nexconn Chat SDK
# ------------------------------------------
NEXCONN_APP_KEY=YOUR_NEXCONN_APP_KEY
NEXCONN_APP_SECRET=YOUR_NEXCONN_APP_SECRET

# ------------------------------------------
# LLM Configuration
# ------------------------------------------
# To switch between Groq (cloud) and local model,
# just change these 3 values. No code changes needed.
#
# === GROQ (default — fast, free tier) ===
#LLM_BASE_URL=https://api.groq.com/openai/v1
#LLM_API_KEY=YOUR_GROQ_API_KEY
#LLM_MODEL=llama-3.1-8b-instant

# === LOCAL llama-server (uncomment to switch) ===
 LLM_BASE_URL=http://127.0.0.1:8080/v1
 LLM_API_KEY=local-no-key-needed
 LLM_MODEL=twil-8b

# ------------------------------------------
# Server
# ------------------------------------------
PORT=3001
NODE_ENV=development

# ------------------------------------------
# Bot User Token (generated server-side via Nexconn Server API)
# ------------------------------------------
NEXCONN_BOT_USER_ID=bot_warroom
NEXCONN_BOT_TOKEN=YOUR_BOT_TOKEN
